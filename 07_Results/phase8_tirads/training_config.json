{
    "phase": "Phase 8 - TI-RADS QuCNet",
    "random_seed": 42,
    "epochs": 100,
    "batch_size": 16,
    "input_shape": [
        64,
        64,
        4
    ],
    "number_of_classes": 6,
    "optimizer": "Adam",
    "learning_rate": 0.0001,
    "loss": "sparse_categorical_crossentropy",
    "early_stopping_patience": 12,
    "reduce_lr_patience": 5,
    "dropout_rate": 0.3,
    "class_mapping": {
        "0": "TI-RADS 2",
        "1": "TI-RADS 3",
        "2": "TI-RADS 4a",
        "3": "TI-RADS 4b",
        "4": "TI-RADS 4c",
        "5": "TI-RADS 5"
    }
}